# Nunca publiques el token ni lo pegues en Discord o en un chat.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DATA_DIR=./data

# Solo traducción manual heredada con OpenAI (desactivada).
# Las novedades automáticas usan MyMemory gratuito y no necesitan estas claves.
AI_ENABLED=false
OPENAI_API_KEY=
# Elegí un modelo disponible en tu cuenta con soporte para Responses API.
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_REQUEST_LIMIT=50
AI_USER_COOLDOWN_SECONDS=30
